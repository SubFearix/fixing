FROM python:3.11-slim

# Создание рабочей директории
WORKDIR /app

# Установка зависимостей Python
# Note: --trusted-host flags are used to bypass SSL verification in development environment
# In production, use a requirements.txt with pinned versions and proper SSL certificates
RUN pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org flask

# Копирование файлов приложения
COPY server.py .
COPY database_client.py .
COPY models.py .
COPY config.docker.json ./config.json

# Экспонирование порта
EXPOSE 5000

# Запуск приложения
# Note: For production deployment, consider using a production WSGI server like gunicorn
CMD ["python", "server.py"]
